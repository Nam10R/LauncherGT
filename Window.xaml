<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="GTA VI · Lanzador" Width="970" Height="812" MinWidth="660" MinHeight="440"
        WindowStartupLocation="CenterScreen" Background="#101017" Foreground="#FFF9F4"
        FontFamily="Inter, Segoe UI" UseLayoutRounding="True" TextOptions.TextFormattingMode="Display">
  <Window.Resources>
    <Style TargetType="Button" x:Key="Action">
      <Setter Property="Background" Value="#292835"/><Setter Property="Foreground" Value="#FAF4EF"/>
      <Setter Property="BorderBrush" Value="#45414D"/><Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Padding" Value="13,7"/><Setter Property="FontSize" Value="13"/>
      <Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value><ControlTemplate TargetType="Button">
          <Border x:Name="Box" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                  BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="5" Padding="{TemplateBinding Padding}">
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True"/>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Box" Property="Opacity" Value="0.84"/></Trigger>
            <Trigger Property="IsPressed" Value="True"><Setter TargetName="Box" Property="Opacity" Value="0.67"/></Trigger>
            <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Box" Property="BorderBrush" Value="White"/></Trigger>
            <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Box" Property="Opacity" Value="0.53"/></Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate></Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="TextAction" TargetType="Button" BasedOn="{StaticResource Action}">
      <Setter Property="Background" Value="Transparent"/><Setter Property="BorderBrush" Value="Transparent"/>
      <Setter Property="Foreground" Value="#E3CFEB"/><Setter Property="Padding" Value="1,3"/>
      <Setter Property="HorizontalAlignment" Value="Left"/><Setter Property="FontSize" Value="12"/>
    </Style>
  </Window.Resources>
  <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
    <Grid x:Name="PageRoot" Background="#101017">
      <Grid.RowDefinitions><RowDefinition Height="238"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
      <Grid ClipToBounds="True" Background="#25172C">
        <Grid.ColumnDefinitions><ColumnDefinition Width="0.43*"/><ColumnDefinition Width="0.57*"/></Grid.ColumnDefinitions>
        <Rectangle Grid.ColumnSpan="2"><Rectangle.Fill><LinearGradientBrush StartPoint="0,0" EndPoint="0.9,1">
          <GradientStop Color="#1D172B" Offset="0"/><GradientStop Color="#382139" Offset="0.52"/><GradientStop Color="#47233C" Offset="1"/>
        </LinearGradientBrush></Rectangle.Fill></Rectangle>
        <Border x:Name="Cover" Grid.Column="1" RenderOptions.BitmapScalingMode="HighQuality"/>
        <Rectangle Grid.Column="1" IsHitTestVisible="False">
          <Rectangle.Fill><LinearGradientBrush StartPoint="0,0.5" EndPoint="1,0.5">
            <GradientStop Color="#302035" Offset="0"/><GradientStop Color="#D5302035" Offset="0.045"/>
            <GradientStop Color="#00302035" Offset="0.27"/>
          </LinearGradientBrush></Rectangle.Fill>
        </Rectangle>
        <StackPanel VerticalAlignment="Center" Margin="32,0,0,0">
          <StackPanel Orientation="Horizontal" Margin="2,0,0,4">
            <Border Width="23" Height="3" CornerRadius="1" Background="#FC9BAB" VerticalAlignment="Center" Margin="0,0,9,0"/>
            <TextBlock Text="GRAND THEFT AUTO VI" Foreground="#FFC0C5" FontFamily="Barlow, Segoe UI" FontSize="13" FontWeight="Bold"/>
          </StackPanel>
          <Viewbox Stretch="Uniform" StretchDirection="DownOnly" HorizontalAlignment="Left" Margin="0,0,10,0">
            <TextBlock Text="LANZADOR" FontFamily="Barlow Condensed, Impact" FontSize="64" Foreground="#FFFAF1"/>
          </Viewbox>
          <TextBlock Text="Xbox Series X  /  Windows" FontSize="15" Foreground="#E0CEDD" Margin="2,6,0,0"/>
          <StackPanel Orientation="Horizontal" Margin="2,12,0,0">
            <TextBlock x:Name="Creator" Text="Made by Nam" Foreground="#E0CEDD" FontSize="13" VerticalAlignment="Center"/>
            <Button x:Name="Discord" Style="{StaticResource Action}" Margin="12,0,0,0" Padding="9,5"
                    Background="#373350" BorderBrush="#7772A5" ToolTip="Unite al servidor de Nam en Discord"
                    AutomationProperties.Name="Abrir el servidor de Nam en Discord">
              <StackPanel Orientation="Horizontal">
                <Path Width="20" Height="16" Fill="White" Stretch="Uniform" VerticalAlignment="Center"
                      Data="M20.317 4.3698a19.7913 19.7913 0 0 0 -4.8851-1.5152.0741.0741 0 0 0 -.0785.0371c-.211.3753-.4447.8648-.6083 1.2495-1.8447-.2762-3.68-.2762-5.4868 0-.1636-.3933-.4058-.8742-.6177-1.2495a.077.077 0 0 0 -.0785-.037 19.7363 19.7363 0 0 0 -4.8852 1.515.0699.0699 0 0 0 -.0321.0277C.5334 9.0458-.319 13.5799.0992 18.0578a.0824.0824 0 0 0 .0312.0561c2.0528 1.5076 4.0413 2.4228 5.9929 3.0294a.0777.0777 0 0 0 .0842-.0276c.4616-.6304.8731-1.2952 1.226-1.9942a.076.076 0 0 0 -.0416-.1057c-.6528-.2476-1.2743-.5495-1.8722-.8923a.077.077 0 0 1 -.0076-.1277c.1258-.0943.2517-.1923.3718-.2914a.0743.0743 0 0 1 .0776-.0105c3.9278 1.7933 8.18 1.7933 12.0614 0a.0739.0739 0 0 1 .0785.0095c.1202.099.246.1981.3728.2924a.077.077 0 0 1 -.0066.1276 12.2986 12.2986 0 0 1 -1.873.8914.0766.0766 0 0 0 -.0407.1067c.3604.698.7719 1.3628 1.225 1.9932a.076.076 0 0 0 .0842.0286c1.961-.6067 3.9495-1.5219 6.0023-3.0294a.077.077 0 0 0 .0313-.0552c.5004-5.177-.8382-9.6739-3.5485-13.6604a.061.061 0 0 0 -.0312-.0286zM8.02 15.3312c-1.1825 0-2.1569-1.0857-2.1569-2.419 0-1.3332.9555-2.4189 2.157-2.4189 1.2108 0 2.1757 1.0952 2.1568 2.419 0 1.3332-.9555 2.4189-2.1569 2.4189zm7.9748 0c-1.1825 0-2.1569-1.0857-2.1569-2.419 0-1.3332.9554-2.4189 2.1569-2.4189 1.2108 0 2.1757 1.0952 2.1568 2.419 0 1.3332-.946 2.4189-2.1568 2.4189Z"/>
                <TextBlock Text="Discord" Margin="6,0,0,0"/>
              </StackPanel>
            </Button>
          </StackPanel>
        </StackPanel>
        <Rectangle Grid.ColumnSpan="2" Height="2" VerticalAlignment="Bottom">
          <Rectangle.Fill><LinearGradientBrush StartPoint="0,0.5" EndPoint="1,0.5">
            <GradientStop Color="#FFB99F" Offset="0"/><GradientStop Color="#E989BB" Offset="0.48"/><GradientStop Color="#67D2CB" Offset="1"/>
          </LinearGradientBrush></Rectangle.Fill>
        </Rectangle>
      </Grid>
      <StackPanel Grid.Row="1" Margin="28,19,28,18">
        <Border Background="#30232F" BorderBrush="#EA9AA7" BorderThickness="3,0,0,0" Padding="13,9" Margin="0,0,0,12">
          <TextBlock x:Name="Warning" Text="Advertencia: para jugar al GTA 6, necesitás tener toda la data (208,50 GB)." TextWrapping="Wrap" FontSize="14" Foreground="#FFDDCF" FontWeight="SemiBold"/>
        </Border>
        <DockPanel Margin="0,0,0,15">
          <Button x:Name="ChooseGame" DockPanel.Dock="Right" VerticalAlignment="Center" Margin="14,0,0,0" Style="{StaticResource Action}" Content="Elegir carpeta"/>
          <StackPanel VerticalAlignment="Center">
            <TextBlock Text="Carpeta del juego" FontWeight="SemiBold" FontSize="14"/>
            <TextBlock x:Name="GameLocation" Text="Elegí dónde tenés tu copia de GTA VI." Foreground="#C8BBCD" FontSize="13" TextTrimming="CharacterEllipsis"/>
          </StackPanel>
        </DockPanel>
        <DockPanel Margin="0,0,0,13">
          <Button x:Name="Refresh" DockPanel.Dock="Right" HorizontalAlignment="Right" Style="{StaticResource Action}"
                  ToolTip="Consultar GitHub y PortWatch ahora. Se comprueban cada 15 minutos." Content="↻  Buscar cambios"/>
          <TextBlock Text="Emuladores" FontSize="26" FontWeight="Bold" VerticalAlignment="Center"/>
        </DockPanel>
        <StackPanel x:Name="Cards"/>
        <Border Background="#36333F" Height="1" Margin="0,5,0,10"/>
        <WrapPanel Margin="0,0,0,6">
          <TextBlock x:Name="LauncherVersion" VerticalAlignment="Center" Foreground="#E0CEDD" Margin="0,0,12,0"/>
          <Button x:Name="UpdateLauncher" Content="Actualizar y reiniciar" Style="{StaticResource Action}" Visibility="Collapsed"/>
        </WrapPanel>
        <TextBlock x:Name="Footer" Text="Consultando GitHub y PortWatch…" TextWrapping="Wrap" Foreground="#BDB4C5" FontSize="12"/>
      </StackPanel>
    </Grid>
  </ScrollViewer>
</Window>
