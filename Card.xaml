<Border xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Background="#1D1B25" BorderBrush="#3A3542" BorderThickness="1" CornerRadius="8" Padding="16,14" Margin="0,0,0,9">
  <Grid>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="Auto"/><ColumnDefinition Width="0.92*"/><ColumnDefinition Width="1.27*"/><ColumnDefinition Width="Auto"/>
    </Grid.ColumnDefinitions>
    <Border x:Name="Logo" Width="52" Height="52" CornerRadius="5" VerticalAlignment="Center"
            RenderOptions.BitmapScalingMode="HighQuality"/>
    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="13,0,8,0">
      <TextBlock x:Name="Engine" FontSize="22" FontWeight="Bold"/>
      <TextBlock x:Name="Base" FontFamily="IBM Plex Mono, Consolas" FontSize="12" Foreground="#BDB4C5" Margin="0,3,0,0" TextWrapping="Wrap"/>
      <Button x:Name="Browse" Content="Elegir .exe" ToolTip="Usar una instalación que ya tenés"/>
    </StackPanel>
    <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="6,0,8,0">
      <TextBlock x:Name="Status" Text="Consultando GitHub…" Foreground="#F5E7F4" FontSize="14" FontWeight="SemiBold" TextWrapping="Wrap"/>
      <WrapPanel Margin="0,2,0,0">
        <Button x:Name="Details" Content="Ver cambios" Margin="0,0,12,0" VerticalAlignment="Center"/>
        <Button x:Name="Install"/>
      </WrapPanel>
    </StackPanel>
    <Button x:Name="Play" Grid.Column="3" VerticalAlignment="Center" MinHeight="42" Width="164"/>
  </Grid>
</Border>
